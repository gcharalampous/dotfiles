# =============================================================================
# PATH
# =============================================================================
export PATH=$HOME/bin:$HOME/.local/bin:/usr/local/bin:$PATH

# =============================================================================
# OH MY ZSH
# =============================================================================
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="powerlevel10k/powerlevel10k"
plugins=(git dnf sudo z extract history colored-man-pages command-not-found zsh-autosuggestions zsh-syntax-highlighting chezmoi command-not-found)
source $ZSH/oh-my-zsh.sh
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# =============================================================================
# EXPORTS
# =============================================================================
export EDITOR="vim"

# =============================================================================
# FZF
# =============================================================================
source /usr/share/fzf/shell/key-bindings.zsh

# =============================================================================
# ALIASES
# =============================================================================
alias cls='clear'
alias ls='lsd'
alias ll='lsd -lah'
alias lt='lsd --tree'
alias cat='bat'
alias gitmeep='cd $HOME/Documents/GitHub/meep-py-scripts'

# >>> conda initialize >>>
# !! Contents within this block are managed by 'conda init' !!
__conda_setup="$('/usr/bin/conda' 'shell.zsh' 'hook' 2> /dev/null)"
if [ $? -eq 0 ]; then
    eval "$__conda_setup"
else
    if [ -f "/usr/etc/profile.d/conda.sh" ]; then
        . "/usr/etc/profile.d/conda.sh"
    else
        export PATH="/usr/bin:$PATH"
    fi
fi
unset __conda_setup
# <<< conda initialize <<<

